POSTGRES_DB=invest
POSTGRES_USER=invest
POSTGRES_PASSWORD=invest_dev_password
# 当前 PostgreSQL 权威端口为 5432；不得改接历史/平行的 5433 实例。
DATABASE_URL=postgresql+psycopg://invest:invest_dev_password@localhost:5432/invest
# Web 对外入口为 3001，API 对外入口为 8000。
API_CORS_ORIGINS=http://localhost:3001
VITE_API_BASE_URL=http://localhost:8000

# --------------------------------------------------------------------------
# Provider selection (ADR-0003)
#
# Phase 1 runtime keeps ONLY the deterministic fixture provider.
# Real third-party providers are intentionally NOT exposed via environment
# variables; see docs/implementation/DATA-SOURCE-MIGRATION-MATRIX.md for
# the archived candidates and the selection process.
# --------------------------------------------------------------------------
INVEST_PIPELINE_PROVIDER_KEY=fixture_dev
# Centralized provider credentials are read from this directory. Explicit
# INVEST_PIPELINE_* credential variables remain supported as overrides.
# INVEST_PIPELINE_SECRETS_DIR=/home/claw/invest-secrets
# Files: cifangquant.api_key, akshare.token, rsscast.token, tushare.token, hithink.api_key
# INVEST_PIPELINE_TUSHARE_ENABLED=false

# TDX offline daily-bars fallback. data_root contains the vipdoc/ directory.
# Tushare remains primary; TDX is used only when the primary request fails.
# INVEST_PIPELINE_TDX_OFFLINE_ENABLED=false
# INVEST_PIPELINE_TDX_OFFLINE_DATA_ROOT=/home/claw/windows-ltsc/shared/tdx-data

# WorkBuddy's only supported integration bridge is the Windows container's
# default shared directory. WorkBuddy-side paths are expressed as `Z:\...`;
# the host-side observation mapping is
# /home/claw/windows-ltsc/shared/ (do not put host paths in WorkBuddy tasks).
# Do not replace this bridge with another mount, NFS path, or temporary dir.
# WorkBuddy candidate intake reads: Z:\选股报告
# invest-infra host-side paths:
# INVEST_PIPELINE_WORKBUDDY_BRIDGE_ROOT=/home/claw/windows-ltsc/shared
# INVEST_PIPELINE_WORKBUDDY_SOURCE_DIR=/home/claw/windows-ltsc/shared/选股报告
# Keep this false until the manual WorkBuddy import has been accepted.
# INVEST_PIPELINE_WORKBUDDY_AUTO_SCHEDULE_ENABLED=false
