POSTGRES_DB=invest
POSTGRES_USER=invest
POSTGRES_PASSWORD=invest_dev_password
DATABASE_URL=postgresql+psycopg://invest:invest_dev_password@localhost:5432/invest
API_CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --------------------------------------------------------------------------
# Provider selection (ADR-0003)
#
# Provider selection is NOT frozen in M0 (see docs/implementation/M0-DECISIONS.md
# and docs/implementation/DATA-SOURCE-MIGRATION-MATRIX.md). Default is
# fixture_dev so no real third-party API is ever called in CI / dev / tests.
#
# To enable a real Provider you MUST also resolve O-1 (Provider selection)
# first and store the real token outside the repository (deployment Secret).
# --------------------------------------------------------------------------
INVEST_PIPELINE_PROVIDER_KEY=fixture_dev

# AkShare (archive data-pipeline/src/collector/etf.py + quotes.py + scripts/save_trading_calendar.py)
# Observed capability: ETF instruments, ETF daily bars, ETF trading calendar,
# index/stock quotes. ARC also noted rate-limit / blocking events.
# Default: disabled. Do NOT mark AkShare as production SLA.
INVEST_PIPELINE_AKSHARE_ENABLED=false
INVEST_PIPELINE_AKSHARE_TOKEN=__SET_VIA_PLATFORM_SECRET__
INVEST_PIPELINE_AKSHARE_BASE_URL=https://example.invalid/akshare
INVEST_PIPELINE_AKSHARE_TIMEOUT_SECONDS=10

# Cifang (archive data-pipeline/src/collector/cifang.py + src/config.py +
# scripts/cron_etf_kline_evening.py + scripts/sync_cifang_backfill.py)
# Observed capability: ETF instruments, ETF daily bars, stock/index quotes.
# Old default was adjustment=qfq. v2 first release freezes adjustment="none"
# (ADR-0005); qfq/hfq MUST NOT be carried over.
INVEST_PIPELINE_CIFANG_ENABLED=false
INVEST_PIPELINE_CIFANG_TOKEN=__SET_VIA_PLATFORM_SECRET__
INVEST_PIPELINE_CIFANG_BASE_URL=https://www.cifangquant.com/api
INVEST_PIPELINE_CIFANG_ADJUSTMENT=none
INVEST_PIPELINE_CIFANG_TIMEOUT_SECONDS=10

# RssCast (archive data-pipeline/src/collector/rsscast.py)
# Research-only. Stock / index MCP quotes only; ETF_DAILY_BARS is NOT in scope.
INVEST_PIPELINE_RSSCAST_ENABLED=false
INVEST_PIPELINE_RSSCAST_TOKEN=__SET_VIA_PLATFORM_SECRET__
INVEST_PIPELINE_RSSCAST_TIMEOUT_SECONDS=10

# quicktiny MCP (archive: report / market-snapshot helpers)
# Research-only. Reports / market snapshots only; ETF_DAILY_BARS is NOT in scope.
INVEST_PIPELINE_QUICKTINY_MCP_ENABLED=false
INVEST_PIPELINE_QUICKTINY_MCP_TOKEN=__SET_VIA_PLATFORM_SECRET__
INVEST_PIPELINE_QUICKTINY_MCP_TIMEOUT_SECONDS=10
