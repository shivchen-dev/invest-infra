[Unit]
Description=invest-infra FastAPI service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/claw/invest-infra/apps/api
ExecStart=/home/claw/invest-infra/apps/api/.venv/bin/uvicorn invest_api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=default.target
