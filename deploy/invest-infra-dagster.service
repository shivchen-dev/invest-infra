[Unit]
Description=invest-infra Dagster pipeline scheduler
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/claw/invest-infra
EnvironmentFile=/home/claw/invest-infra/apps/pipeline/.env
Environment=INVEST_PIPELINE_AUTO_SCHEDULE_ENABLED=true
Environment=DAGSTER_HOME=/home/claw/invest-infra/.dagster
ExecStart=/home/claw/invest-infra/apps/pipeline/.venv/bin/dagster dev -m invest_pipeline.definitions -h 0.0.0.0 -p 3000
Restart=on-failure
RestartSec=10s
UMask=0077

[Install]
WantedBy=default.target
