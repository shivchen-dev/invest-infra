      "DataFreshnessResponse": {
        "description": "Response envelope for the ``GET /api/v1/data-freshness`` endpoint.\n\n``status`` follows the same vocabulary the front-end uses for the\npersonal daily-job banner. ``missing_count`` is the gap between the\nactive instrument universe and the daily bars observed for\n``expected_trade_date``; it is always\n``max(0, universe_count - daily_bar_count)`` regardless of the\nhigh-level ``status`` so the UI can surface a progress bar.",
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "candidate_count": {
            "minimum": 0.0,
            "title": "Candidate Count",
            "type": "integer"
          },
          "daily_bar_count": {
            "minimum": 0.0,
            "title": "Daily Bar Count",
            "type": "integer"
          },
          "latest_published_trade_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Published Trade Date"
          },
          "missing_count": {
            "minimum": 0.0,
            "title": "Missing Count",
            "type": "integer"
          },
          "pipeline_run_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pipeline Run Id"
          },
          "pipeline_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pipeline Status"
          },
          "snapshot_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Id"
          },
          "status": {
            "enum": [
              "fresh",
              "partial",
              "stale",
              "missing",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "universe_count": {
            "minimum": 0.0,
            "title": "Universe Count",
            "type": "integer"
          }
        },
        "required": [
          "as_of",
          "universe_count",
          "daily_bar_count",
          "missing_count",
          "candidate_count",
          "status"
        ],
        "title": "DataFreshnessResponse",
        "type": "object"
      },
