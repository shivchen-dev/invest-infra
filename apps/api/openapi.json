  "info": {
    "title": "invest-infra-v2",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/candidate-pool/latest": {
      "get": {
        "description": "Return the most recently published candidate-pool run.",
        "operationId": "get_latest_candidate_pool_api_v1_candidate_pool_latest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidatePoolLatestResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Latest Candidate Pool",
        "tags": [
          "candidate-pool"
        ]
      }
    },
    "/api/v1/candidate-pool/latest/diff": {
      "get": {
