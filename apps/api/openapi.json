            "title": "Run Id",
            "type": "string"
          },
          "snapshot_id": {
            "format": "uuid",
            "title": "Snapshot Id",
            "type": "string"
          },
          "trade_date": {
            "format": "date",
            "title": "Trade Date",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "trade_date",
          "algorithm_key",
          "algorithm_version",
          "parameter_set_key",
          "snapshot_id",
          "content_hash",
          "row_count",
