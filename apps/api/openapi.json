            "type": "string"
          },
          "algorithm_version": {
            "title": "Algorithm Version",
            "type": "string"
          },
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "excluded_count": {
            "minimum": 0.0,
            "title": "Excluded Count",
            "type": "integer"
          },
          "included_count": {
            "minimum": 0.0,
            "title": "Included Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CandidatePoolItemResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "parameter_set_key": {
            "title": "Parameter Set Key",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "row_count": {
            "minimum": 0.0,
            "title": "Row Count",
            "type": "integer"
          },
          "run_id": {
