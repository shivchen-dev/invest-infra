      "PipelineRunListResponse": {
        "description": "Paginated envelope for the ``GET /api/v1/pipeline-runs`` endpoint.\n\n``total`` counts every ``personal_etf_daily_job`` run (i.e. it is\ncomputed independently of ``limit`` / ``offset``) so the UI can\nrender the page count without an extra round trip. ``items`` is\nalways ordered by ``started_at`` descending and then ``id``\nascending so successive pages are stable.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PipelineRunResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "maximum": 100.0,
            "minimum": 1.0,
