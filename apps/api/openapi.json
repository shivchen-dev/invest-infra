            "type": "array"
          },
          "included": {
            "title": "Included",
            "type": "boolean"
          },
          "instrument_id": {
            "format": "uuid",
            "title": "Instrument Id",
            "type": "string"
          },
          "metrics": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Metrics",
            "type": "object"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          },
          "rule_results": {
            "items": {
              "$ref": "#/components/schemas/RuleOutcomeResponse"
            },
            "title": "Rule Results",
            "type": "array"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "total_score": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Score"
          }
        },
        "required": [
          "instrument_id",
          "included"
        ],
        "title": "CandidatePoolItemResponse",
        "type": "object"
      },
      "CandidatePoolLatestResponse": {
        "description": "Response envelope for the ``GET /api/v1/candidate-pool/latest`` endpoint.",
