{
  "components": {
    "schemas": {
      "CandidatePoolDiffEntry": {
        "description": "One instrument entry in a candidate-pool diff bucket.\n\nCarries the raw ``instrument_id`` plus the resolved display fields\nso the Web can render the diff without making a follow-up Instrument\nlookup. ``symbol`` / ``name`` / ``exchange`` are ``None`` when the\ninstrument row is missing; ordering is deterministic - ``symbol``\nascending with ``instrument_id`` as the tiebreaker.",
        "properties": {
          "exchange": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange"
          },
          "instrument_id": {
            "format": "uuid",
            "title": "Instrument Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          }
        },
        "required": [
          "instrument_id"
        ],
        "title": "CandidatePoolDiffEntry",
        "type": "object"
      },
      "CandidatePoolDiffResponse": {
        "description": "Response envelope for the candidate-pool diff endpoints.\n\nCompares the set of ``included=True`` instruments in the current\npublished run against the most recent earlier published run.\n``added`` is the set of instruments that appear only in the current\nrun, ``retained`` is the intersection, and ``removed`` is the set\nthat appear only in the previous run. Excluded items (where\n``included=False``) are NEVER reported in any bucket - the diff\nreflects candidate-pool membership changes, not input-pool changes.\nWhen no earlier published run exists, ``previous_trade_date`` is\n``None`` and every included instrument in the current run is\nreported as ``added`` with ``retained`` and ``removed`` both empty.",
        "properties": {
          "added": {
            "items": {
              "$ref": "#/components/schemas/CandidatePoolDiffEntry"
            },
            "title": "Added",
            "type": "array"
          },
          "previous_trade_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Trade Date"
          },
          "removed": {
            "items": {
              "$ref": "#/components/schemas/CandidatePoolDiffEntry"
            },
            "title": "Removed",
            "type": "array"
          },
          "retained": {
            "items": {
              "$ref": "#/components/schemas/CandidatePoolDiffEntry"
            },
            "title": "Retained",
            "type": "array"
          },
          "trade_date": {
            "format": "date",
            "title": "Trade Date",
            "type": "string"
          }
        },
        "required": [
          "trade_date"
        ],
        "title": "CandidatePoolDiffResponse",
        "type": "object"
      },
      "CandidatePoolItemResponse": {
        "description": "One per-instrument judgment from the latest published pool.",
        "properties": {
          "exchange": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange"
